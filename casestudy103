string replaceto(string targettxt, char toChangeChar, char toReplaceChar) {
	for (int i = 0; i < targettxt.length(); i++) {
		if(targettxt[i] == toChangeChar) {
			targettxt[i] = toReplaceChar;
		}
	}
}

